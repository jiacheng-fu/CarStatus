# Copy this file to ".env" and fill in your real values.
# ".env" is gitignored and will NOT be committed. This template IS committed.

# From dashboard.smartcar.com > your app > Configuration.
# Application details > Application ID (a UUID): used to launch Smartcar Connect.
SMARTCAR_APPLICATION_ID=your-application-id
# API credentials > Client ID (client_...) and a secret from "Generate new secret".
SMARTCAR_CLIENT_ID=client_your-client-id
SMARTCAR_CLIENT_SECRET=your-client-secret

# Must EXACTLY match a Redirect URI registered under Application details.
SMARTCAR_REDIRECT_URI=http://localhost:8000/callback

# "live" for a real car, "simulated" for a Smartcar Simulator vehicle (free).
SMARTCAR_MODE=live

# Optional, for `npm run webhook`: Configuration > API credentials > Application management token.
# Smartcar v3 only fills a vehicle's signal store from webhook deliveries (see README).
SMARTCAR_MANAGEMENT_TOKEN=your-management-token
